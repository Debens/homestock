{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.debens.homestock"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
